const express = require('express');
const bodyParser = require('body-parser');
const { ethers } = require('ethers');
require('dotenv').config();

const app = express();
const PORT = process.env.PORT || 3000;

app.use(bodyParser.json());

// Standard ERC-20 ABI (constructor: name, symbol, initialSupply)
const ERC20_ABI = [
  "constructor(string memory name, string memory symbol, uint256 initialSupply)",
  "function name() view returns (string)",
  "function symbol() view returns (string)",
  "function decimals() view returns (uint8)",
  "function totalSupply() view returns (uint256)",
  "function balanceOf(address owner) view returns (uint256)",
  "function transfer(address to, uint amount) returns (bool)",
  "event Transfer(address indexed from, address indexed to, uint amount)"
];

// Precompiled ERC-20 bytecode (18 decimals, simple token). From Remix compile:
const ERC20_BYTECODE = "";
 
app.post('/deploy', async (req, res) => {
  const { name, symbol, supply, wallet } = req.body;

  if (!name || !symbol || !supply || !wallet) {
    return res.status(400).json({ success: false, error: 'Missing fields' });
  }

  try {
    const provider = new ethers.JsonRpcProvider(process.env.RPC_URL);
    const walletSigner = new ethers.Wallet(process.env.PRIVATE_KEY, provider);

    const factory = new ethers.ContractFactory(ERC20_ABI, ERC20_BYTECODE, walletSigner);

    const initialSupply = ethers.utils.parseUnits(supply.toString(), 18); // 18 decimals
    const contract = await factory.deploy(name, symbol, initialSupply);
    await contract.waitForDeployment();
    const tokenAddress = await contract.getAddress();

    res.json({ success: true, address: tokenAddress });
  } catch (err) {
    console.error(err);
    res.status(500).json({ success: false, error: err.message });
  }
});

app.listen(PORT, () => {
  console.log(`Crypto deploy server running on port ${PORT}`);
});
